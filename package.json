{
  "name": "@treeseed-cordis/sdk",
  "version": "0.0.0-cordis.37",
  "private": true,
  "type": "module",
  "exports": {
    "./provider-control": {
      "types": "./dist/src/provider-control.d.ts",
      "default": "./dist/src/provider-control.js"
    },
    "./provider-control-contracts": {
      "types": "./dist/src/provider-control-contracts.d.ts",
      "default": "./dist/src/provider-control-contracts.js"
    },
    ".": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./source-policy": {
      "types": "./dist/src/source-policy.d.ts",
      "default": "./dist/src/source-policy.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "default": "./dist/src/runtime.js"
    },
    "./composition": {
      "types": "./dist/src/composition.d.ts",
      "default": "./dist/src/composition.js"
    },
    "./portable": {
      "types": "./dist/src/portable.d.ts",
      "default": "./dist/src/portable.js"
    },
    "./seeds": {
      "types": "./dist/src/seeds.d.ts",
      "default": "./dist/src/seeds.js"
    }
  },
  "files": [
    "dist/src",
    "dist/contract.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun run check:readability && bun run check:test-layout && bun scripts/tooling.ts check",
    "build": "bun scripts/tooling.ts build",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration",
    "test:smoke": "bun run test:acceptance",
    "verify": "bun run check && bun run build && bun run test:acceptance && bun run test:regression && bun run test:integration && bun run test:unit",
    "check:test-layout": "bun .agents/skills/release-workflow/scripts/test-layout.ts",
    "test:regression": "bun test ./tests/regression",
    "test:acceptance": "bun test ./tests/acceptance",
    "check:readability": "bun .agents/skills/release-workflow/scripts/source-readability.ts"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  },
  "packageManager": "bun@1.4.4",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0"
  }
}
