      "default": "./dist/content/validation/index.js"
    },
    "./treedx": {
      "types": "./dist/treedx/index.d.ts",
      "default": "./dist/treedx/index.js"
    },
    "./treedx/client": {
      "types": "./dist/treedx/client.d.ts",
      "default": "./dist/treedx/client.js"
    },
    "./treedx/types": {
      "types": "./dist/treedx/types.d.ts",
      "default": "./dist/treedx/types.js"
    },
    "./treeai": {
      "types": "./dist/treeai/index.d.ts",
      "default": "./dist/treeai/index.js"
    },
    "./capacity-provider": {
      "types": "./dist/capacity/providers/capacity-provider.d.ts",
      "default": "./dist/capacity/providers/capacity-provider.js"
    },
    "./capacity-provider/sandbox": {
      "types": "./dist/capacity-provider/sandbox.d.ts",
