{
  "name": "@treeseed-cordis/sdk",
  "version": "0.0.0-cordis.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./source-policy": {
      "types": "./dist/src/source-policy.d.ts",
      "default": "./dist/src/source-policy.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "default": "./dist/src/runtime.js"
    },
    "./composition": {
      "types": "./dist/src/composition.d.ts",
      "default": "./dist/src/composition.js"
    },
    "./portable": {
      "types": "./dist/src/portable.d.ts",
      "default": "./dist/src/portable.js"
    }
  },
  "files": [
    "dist/src",
    "dist/contract.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun scripts/tooling.ts check",
    "build": "bun scripts/tooling.ts build",
    "test:unit": "bun test ./tests --test-name-pattern '^unit:'",
    "test:integration": "bun test ./tests --test-name-pattern '^integration:'",
    "test:smoke": "bun test ./tests --test-name-pattern '^smoke:'",
    "verify": "bun run check && bun run build && bun run test:unit && bun run test:integration && bun run test:smoke"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0"
  }
}
