{
  "name": "@treeseed/sdk",
  "version": "0.13.0-rc.79",
  "description": "Portable TreeSeed contracts, standards, and typed remote control-plane clients.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/treeseed-ai/sdk.git",
    "directory": "."
  },
  "homepage": "https://treeseed.ai",
  "bugs": {
    "url": "https://github.com/treeseed-ai/sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "npm install",
    "setup:ci": "npm ci",
    "build": "npm run build:dist",
    "build:dist": "node --import tsx ./scripts/build/build-dist.ts",
    "check:file-lengths": "node --import tsx ./scripts/verification/check-file-lengths.ts && npm run check:file-architecture",
    "check:file-architecture": "node --import tsx ./scripts/verification/check-file-architecture.ts",
    "prepare": "npm run build:dist",
    "prepack": "npm run build:dist",
    "test": "npm run test:contracts",
    "test:contracts": "vitest run --config ./vitest.contracts.config.ts",
    "test:release": "npm run test:contracts",
    "lint": "npm run build:dist",
    "verify:direct": "npm run release:verify",
    "release:setup": "npm run setup:ci",
    "release:check-tag": "node --import tsx ./scripts/packages/assert-release-tag-version.ts",
    "release:verify": "npm run check:file-lengths && node --import tsx ./scripts/packages/release-verify.ts",
    "release:publish": "node --import tsx ./scripts/packages/publish-package.ts",
    "release:readback": "node --import tsx ./scripts/packages/verify-published-package.ts",
    "release:verify-custody": "node --import tsx ./scripts/packages/verify-release-custody.ts",
    "standards:baseline": "node --import tsx ./scripts/standards/acquire-accepted-baseline.ts",
    "standards:build": "node --import tsx ./scripts/standards/build-contract-bundle.ts",
    "standards:compatibility": "node --import tsx ./scripts/standards/compare-compatibility.ts",
    "standards:compose": "node --import tsx ./scripts/standards/resolve-composition.ts",
    "standards:acceptance": "node --import tsx ./scripts/standards/package-acceptance.ts",
    "standards:release-evidence": "node --import tsx ./scripts/standards/create-release-evidence.ts"
  },
  "dependencies": {
    "@treeseed/treedx": "0.3.0-rc.4",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "exports": {
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./development": {
